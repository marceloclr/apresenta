    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "chart.js": "4.5.1",
    "dompurify": "3.4.16",
    "js-yaml": "5.4.2",
    "markdown-it": "15.0.2",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-container": "4.0.0",
